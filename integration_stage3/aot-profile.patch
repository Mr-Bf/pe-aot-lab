+static void AotClearOpaqueEffects(llvm::Module *module) {
+  for (auto &fn : *module) {
+    if(!fn.getName().startswith("__remill_") && !fn.getName().startswith("aot_")) continue;
+    fn.setMemoryEffects(llvm::MemoryEffects::unknown());
+    fn.removeFnAttr(llvm::Attribute::Speculatable);
+    for(auto &arg:fn.args()) {
+      for(auto attr:{llvm::Attribute::ReadNone,llvm::Attribute::ReadOnly,llvm::Attribute::WriteOnly,
+                     llvm::Attribute::NoAlias,llvm::Attribute::NoCapture})arg.removeAttr(attr);
+    }
+    for(auto user:fn.users())if(auto call=llvm::dyn_cast<llvm::CallBase>(user)) {
+      call->setMemoryEffects(llvm::MemoryEffects::unknown());
+      call->removeFnAttr(llvm::Attribute::Speculatable);
+      for(unsigned a=0;a<call->arg_size();++a)
+        for(auto attr:{llvm::Attribute::ReadNone,llvm::Attribute::ReadOnly,llvm::Attribute::WriteOnly,
+                       llvm::Attribute::NoAlias,llvm::Attribute::NoCapture})call->removeParamAttr(a,attr);
+    }
+  }
+}
