+// aot-stage3: closed scalar profile, checked with XED before lifting.
+static bool AotPreflight(const remill::Arch *arch, Memory &memory) {
+  using I = remill::Instruction;
+  const std::set<std::string> allowed = {
+    "MOV","MOVZX","MOVSX","MOVSXD","LEA","ADD","SUB","XOR","AND","OR",
+    "TEST","CMP","ROL","INC","DEC","NOP","PUSH","POP","CALL_NEAR","RET_NEAR",
+    "JMP","JB","JBE","JL","JLE","JNB","JNBE","JNL","JNLE","JNO","JNP",
+    "JNS","JNZ","JO","JP","JS","JZ"
+  };
+  std::set<uint64_t> pending{FLAGS_entry_address};
+  std::map<uint64_t,uint64_t> owner;
+  std::map<uint64_t,std::string> records;
+  while (!pending.empty()) {
+    uint64_t pc=*pending.begin(); pending.erase(pending.begin());
+    if (records.count(pc)) continue;
+    if (owner.count(pc) && owner[pc]!=pc) {
+      std::cerr << "REJECT overlapping instruction at " << pc << '\n'; return false;
+    }
+    uint8_t bytes[15]; unsigned size=0;
+    while(size<15 && memory.count(pc+size)) {bytes[size]=memory.at(pc+size);++size;}
+    xed_state_t mode; xed_state_zero(&mode);
+    mode.mmode=XED_MACHINE_MODE_LONG_64;mode.stack_addr_width=XED_ADDRESS_WIDTH_64b;
+    xed_decoded_inst_t decoded; xed_decoded_inst_zero_set_mode(&decoded,&mode);
+    auto err=xed_decode(&decoded,bytes,size);
+    if(err!=XED_ERROR_NONE) {std::cerr << "REJECT XED decode at " << pc << '\n';return false;}
+    std::string iclass=xed_iclass_enum_t2str(xed_decoded_inst_get_iclass(&decoded));
+    unsigned length=xed_decoded_inst_get_length(&decoded);
+    for(unsigned n=0;n<length;++n) {
+      uint8_t b=bytes[n];
+      if(b==0xf0 || b==0xf2 || b==0xf3 || b==0x64 || b==0x65 || b==0x67 ||
+         b==0x2e || b==0x36 || b==0x3e || b==0x26) {
+        std::cerr << "REJECT prefix at " << pc << '\n';return false;
+      }
+      if(b==0x66 || (b>=0x40&&b<=0x4f)) continue;
+      break;
+    }
+    if(!allowed.count(iclass)) {std::cerr << "REJECT iclass " << iclass << " at " << pc << '\n';return false;}
+    const auto templ=xed_decoded_inst_inst(&decoded);
+    for(unsigned op=0;op<xed_inst_noperands(templ);++op) {
+      const auto name=xed_operand_name(xed_inst_operand(templ,op));
+      if(!xed_operand_is_register(name)) continue;
+      const auto reg=xed_decoded_inst_get_reg(&decoded,name);
+      // XED models the implicit stack effect of CALL/RET/PUSH/POP as pseudo-registers.
+      if(reg==XED_REG_STACKPUSH || reg==XED_REG_STACKPOP) continue;
+      switch(xed_reg_class(reg)) {
+        case XED_REG_CLASS_GPR: case XED_REG_CLASS_GPR8: case XED_REG_CLASS_GPR16:
+        case XED_REG_CLASS_GPR32: case XED_REG_CLASS_GPR64:
+        case XED_REG_CLASS_IP: case XED_REG_CLASS_FLAGS:break;
+        default:std::cerr << "REJECT non-GPR register " << xed_reg_enum_t2str(reg) << '\n';return false;
+      }
+    }
+    if(iclass=="RET_NEAR" && xed_decoded_inst_get_immediate_width_bits(&decoded)) {
+      std::cerr << "REJECT RET immediate stack cleanup\n";return false;
+    }
+    for(unsigned m=0;m<xed_decoded_inst_number_of_memory_operands(&decoded);++m) {
+      if(xed_decoded_inst_mem_read(&decoded,m)&&xed_decoded_inst_mem_written(&decoded,m)) {
+        std::cerr << "REJECT memory RMW at " << pc << '\n';return false;
+      }
+      if(xed_decoded_inst_get_base_reg(&decoded,m)==XED_REG_INVALID &&
+         xed_decoded_inst_get_index_reg(&decoded,m)==XED_REG_INVALID) {
+        std::cerr << "REJECT absolute memory addressing\n";return false;
+      }
+      unsigned width=xed_decoded_inst_get_memory_operand_length(&decoded,m);
+      if(iclass!="LEA" && width!=1&&width!=2&&width!=4&&width!=8) {std::cerr << "REJECT memory width\n";return false;}
+    }
+    I inst;
+    std::string raw(reinterpret_cast<char*>(bytes),length);
+    if(!arch->DecodeInstruction(pc,raw,inst,arch->CreateInitialContext()) || inst.bytes.size()!=length) {
+      std::cerr << "REJECT Remill/XED mismatch\n";return false;
+    }
+    int kind=0;
+    switch(inst.category) {
+      case I::kCategoryNormal: case I::kCategoryNoOp: pending.insert(inst.next_pc);break;
+      case I::kCategoryDirectJump: pending.insert(inst.branch_taken_pc);break;
+      case I::kCategoryConditionalBranch:
+        pending.insert(inst.branch_taken_pc);pending.insert(inst.branch_not_taken_pc);break;
+      case I::kCategoryDirectFunctionCall:
+        if(inst.branch_taken_pc==inst.branch_not_taken_pc) {
+          std::cerr << "REJECT call-to-next special case\n";return false;
+        }
+        kind=1;pending.insert(inst.branch_taken_pc);pending.insert(inst.branch_not_taken_pc);break;
+      case I::kCategoryFunctionReturn:kind=2;break;
+      default:std::cerr << "REJECT control category\n";return false;
+    }
+    unsigned reads=0,writes=0,undefs=0;
+    if(auto f=xed_decoded_inst_get_rflags_info(&decoded)) {
+      reads=xed_flag_set_mask(xed_simple_flag_get_read_flag_set(f));
+      writes=xed_flag_set_mask(xed_simple_flag_get_written_flag_set(f));
+      undefs=xed_flag_set_mask(xed_simple_flag_get_undefined_flag_set(f));
+    }
+    if(iclass=="ROL" && inst.function.find("_CL")!=std::string::npos) {
+      std::cerr << "REJECT variable rotate count\n";return false;
+    }
+    if(iclass=="ROL") {
+      unsigned bits=xed_decoded_inst_get_operand_width(&decoded);
+      unsigned count=inst.function.find("_ONE")!=std::string::npos ? 1 :
+          unsigned(xed_decoded_inst_get_unsigned_immediate(&decoded));
+      count &= (bits==64 ? 63 : 31);
+      if(count && count%bits==0) {std::cerr << "REJECT full-width rotate count\n";return false;}
+      reads=0;writes=count ? 1U|(count==1?0x800U:0U) : 0;
+      undefs=count>1 ? 0x800U : 0;
+    }
+    for(unsigned n=0;n<length;++n) {
+      if(owner.count(pc+n) && owner[pc+n]!=pc) {std::cerr << "REJECT overlap\n";return false;}
+      owner[pc+n]=pc;
+    }
+    std::ostringstream rec;
+    rec << "{\"address\":"<<pc<<",\"length\":"<<length<<",\"kind\":"<<kind
+        <<",\"iclass\":\""<<iclass<<"\",\"xed_category\":\""
+        <<xed_category_enum_t2str(xed_decoded_inst_get_category(&decoded))
+        <<"\",\"remill_category\":"<<int(inst.category)
+        <<",\"function\":\""<<inst.function<<"\",\"next_pc\":"<<inst.next_pc
+        <<",\"target_pc\":"<<inst.branch_taken_pc<<",\"fallthrough_pc\":"<<inst.branch_not_taken_pc
+        <<",\"immediate_width\":"<<xed_decoded_inst_get_immediate_width_bits(&decoded)
+        <<",\"immediate\":"<<xed_decoded_inst_get_unsigned_immediate(&decoded)
+        <<",\"flags_read\":"<<reads<<",\"flags_written\":"<<writes<<",\"flags_undefined\":"<<undefs<<"}";
+    records.emplace(pc,rec.str());
+  }
+  std::ofstream out(FLAGS_aot_manifest);
+  out<<"[";bool first=true;for(const auto &item:records){if(!first)out<<",";first=false;out<<item.second;}out<<"]\n";
+  return out.good();
+}
