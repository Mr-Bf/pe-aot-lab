-  std::unique_ptr<llvm::Module> module(remill::LoadArchSemantics(arch.get()));
+  // The portable provider never searches historical build/install directories.
+  // Preserve LoadArchSemantics initialization, using an explicit parsed file.
+  const std::filesystem::path requested_semantics(FLAGS_aot_semantics);
+  if (FLAGS_aot_semantics.empty() || !requested_semantics.is_absolute()) {
+    std::cerr << "REJECT: --aot_semantics requires an absolute file path\n";
+    return EXIT_FAILURE;
+  }
+  std::error_code semantics_error;
+  const auto semantics_path =
+      std::filesystem::canonical(requested_semantics, semantics_error);
+  if (semantics_error ||
+      !std::filesystem::is_regular_file(semantics_path, semantics_error) ||
+      semantics_error) {
+    std::cerr << "REJECT: explicit semantics file does not exist or is not regular\n";
+    return EXIT_FAILURE;
+  }
+  std::cerr << "AOT_SEMANTICS_REQUEST=" << FLAGS_aot_semantics << "\n"
+            << "AOT_SEMANTICS_PATH=" << semantics_path.string() << "\n";
+  llvm::SMDiagnostic semantics_diagnostic;
+  auto module = llvm::parseIRFile(semantics_path.string(),
+                                  semantics_diagnostic, context);
+  if (!module) {
+    std::cerr << "REJECT: cannot parse explicit semantics file\n";
+    semantics_diagnostic.print("remill-lift", llvm::errs());
+    return EXIT_FAILURE;
+  }
+  if (llvm::verifyModule(*module, &llvm::errs())) {
+    std::cerr << "REJECT: invalid explicit semantics module\n";
+    return EXIT_FAILURE;
+  }
+  arch->PrepareModule(module);
+  arch->InitFromSemanticsModule(module.get());
+  for (auto &func : *module) {
+    remill::Annotate<remill::Semantics>(&func);
+  }
 
